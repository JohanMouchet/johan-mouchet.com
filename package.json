{
  "name": "johan-mouchet",
  "version": "7.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --watch",
    "type-check": "tsc --noEmit",
    "lint:js": "eslint .",
    "lint:css": "stylelint src/**/*.scss",
    "format": "pnpm lint:js -- --fix && pnpm lint:css -- --fix && prettier --write src/**/*.{ts,tsx,js,json,mdx}",
    "analyze": "cross-env ANALYZE=true next build",
    "build": "next build",
    "build:storybook": "storybook build",
    "build:all": "pnpm build && pnpm build:storybook",
    "prepare": "husky install",
    "chromatic": "chromatic --exit-zero-on-changes --build-script-name=build:storybook",
    "codegen": "prismic-ts-codegen"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/client": "^3.7.10",
    "@prismicio/client": "^6.7.3",
    "@prismicio/helpers": "^2.3.9",
    "@prismicio/react": "^2.5.2",
    "chromatic": "^11.5.6",
    "clsx": "^1.2.1",
    "date-fns": "^2.29.3",
    "dompurify": "^3.0.1",
    "embla-carousel-react": "^8.0.2",
    "html-react-parser": "^5.2.8",
    "isomorphic-dompurify": "^1.1.0",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.3",
    "@next/bundle-analyzer": "^16.0.1",
    "@prismicio/types": "^0.2.7",
    "@storybook/addon-a11y": "^10.1.2",
    "@storybook/addon-docs": "^10.1.2",
    "@storybook/nextjs-vite": "^10.1.2",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.3.2",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^2.4.0",
    "@types/node": "^18.15.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "baseline-browser-mapping": "^2.8.32",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-storybook": "^10.1.2",
    "husky": "^8.0.0",
    "jsdom": "^24.1.1",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.7",
    "prismic-ts-codegen": "^0.1.19",
    "sass": "^1.89.2",
    "storybook": "^10.1.2",
    "stylelint": "^16.25.0",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "vite-plugin-magical-svg": "^1.3.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.0.3"
  }
}
